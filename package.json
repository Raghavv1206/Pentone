{
  "name": "pentone",
  "displayName": "Pentone",
  "version": "1.1.1",
  "description": "Pentone helps you navigate websites, write, and organize information with on-device AI.",
  "author": "Younes Laaroussi ceo@vidova.ai",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build && node scripts/post-build.js",
    "package": "pnpm build && pnpm verify:build && plasmo package",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "pretest": "node scripts/build-page-agent.cjs --test",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:build",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@picovoice/porcupine-web": "^3.0.3",
    "@picovoice/web-voice-processor": "^4.0.9",
    "@plasmohq/messaging": "^0.7.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.2.1",
    "@types/animejs": "^3.1.13",
    "@types/howler": "^2.2.12",
    "@types/turndown": "^5.0.5",
    "@xenova/transformers": "^2.17.2",
    "animejs": "^4.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compromise": "^14.19.0",
    "compromise-numbers": "^1.4.0",
    "dom-accessibility-api": "^0.7.1",
    "double-metaphone": "^2.0.1",
    "framer-motion": "^12.23.12",
    "fuse.js": "^7.5.0",
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.544.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^5.4.296",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^15.7.3",
    "react-icons": "^5.5.0",
    "react-markdown": "8.0.7",
    "remark-gfm": "3.0.1",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "0.1.1",
    "@types/node": "20.11.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "jsdom": "^27.4.0",
    "plasmo": "0.90.5",
    "postcss": "^8.5.6",
    "pptxgenjs": "^4.0.1",
    "prettier": "3.2.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "5.3.3",
    "vitest": "^4.1.12"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "<all_urls>"
    ],
    "action": {},
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "permissions": [
      "tabs",
      "activeTab",
      "tabCapture",
      "scripting",
      "storage",
      "unlimitedStorage",
      "sidePanel",
      "webNavigation",
      "offscreen",
      "contextMenus"
    ],
    "optional_permissions": ["tabGroups", "bookmarks", "downloads", "history", "sessions"],
    "externally_connectable": {},
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "assets/dom-to-semantic-markdown.js",
          "assets/Hey-Pentone_en_wasm_v3_0_0.ppn",
          "assets/porcupine_params.pv",
          "assets/Readability.js",
          "assets/pdf.worker.min.mjs",
          "assets/ort-wasm/*",
          "assets/*.ogg",
          "assets/*.wav"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "overrides": {
      "onnxruntime-web": "1.14.0",
      "protobufjs": "^7.6.3",
      "@protobufjs/utf8": "^1.1.1",
      "sharp": "^0.35.5",
      "diff@5": "^5.2.2",
      "nanoid@5": "^5.1.16",
      "@babel/core": "^7.29.6",
      "baseline-browser-mapping": "^2.11.0",
      "brace-expansion@2": "^2.1.7",
      "browserslist": "^4.28.7",
      "fflate@0.8": "^0.8.3",
      "glob@10": "^10.5.0",
      "immutable@5": "^5.1.8",
      "js-yaml@4": "^4.3.2",
      "minimatch@9": "^9.0.7",
      "msgpackr": "^1.10.1",
      "nanoid@3": "^3.3.18",
      "picomatch@2": "^2.3.2",
      "postcss": "^8.5.23",
      "postcss-selector-parser@6": "^6.1.5",
      "rollup@3": "^3.30.0",
      "source-map-js": "^1.2.2",
      "svgo@2": "^2.8.4",
      "yaml@1": "^1.10.3",
      "vue": "^3.5.42",
      "@vue/server-renderer": "^3.5.42"
    }
  }
}

{
  "name": "pentone",
  "displayName": "Pentone",
  "version": "1.0.0",
  "description": "Pentone lets you navigate and control any website using natural language, entirely offline and private.",
  "author": "Younes Laaroussi ceo@vidova.ai",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "postbuild": "node scripts/patch-bundle.js",
    "package": "plasmo package",
    "test": "tsx --test tests/tool-parser.test.ts tests/ai-config.test.ts tests/security.test.ts tests/session-lifecycle.test.ts tests/conversation-integrity.test.ts tests/context-summarizer-selection.test.ts tests/voice-memory-reliability.test.ts tests/agent-execution-reasoning.test.ts tests/agent-reliability-audio.test.ts tests/full-duplex-audio-stage1.test.ts tests/local-whisper-asr-stage2.test.ts tests/barge-in-cancellation-stage3.test.ts tests/voice-model-preloading-noise-rejection.test.ts tests/critical-voice-pipeline-remediation.test.ts tests/persistent-audio-pipeline-ptt.test.ts tests/critical-production-recovery.test.ts tests/all-26-tools-contract.test.ts tests/document-processor-repair.test.ts tests/feature-repair-and-completion.test.ts tests/phase6-complete-feature-reliability.test.ts tests/onboarding-and-model-provisioning.test.ts"
  },
  "dependencies": {
    "@picovoice/porcupine-web": "^3.0.3",
    "@picovoice/web-voice-processor": "^4.0.9",
    "@plasmohq/messaging": "^0.7.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.2.1",
    "@ricky0123/vad-web": "^0.0.31",
    "@types/animejs": "^3.1.13",
    "@types/howler": "^2.2.12",
    "@types/turndown": "^5.0.5",
    "@xenova/transformers": "^2.17.2",
    "animejs": "^4.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^5.4.296",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^15.7.3",
    "react-icons": "^5.5.0",
    "react-markdown": "8.0.7",
    "remark-gfm": "3.0.1",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.1.1",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "<all_urls>"
    ],
    "action": {
      "default_title": "Pentone Voice Assistant"
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "permissions": [
      "tabs",
      "activeTab",
      "tabCapture",
      "scripting",
      "storage",
      "unlimitedStorage",
      "sidePanel",
      "webNavigation"
    ],
    "externally_connectable": {},
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval' blob:; object-src 'self'; worker-src 'self' blob:;"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "assets/dom-to-semantic-markdown.js",
          "assets/Hey-Marionette_en_wasm_v3_0_0.ppn",
          "assets/porcupine_params.pv",
          "assets/Readability.js",
          "assets/pdf.worker.min.mjs",
          "assets/ort-wasm-simd-threaded.mjs",
          "assets/ort-wasm-simd-threaded.jsep.mjs",
          "assets/silero_vad_*.onnx",
          "assets/cam_speaker.onnx",
          "assets/vad.worklet.bundle.min.js",
          "assets/pentone-audio-processor.js",
          "assets/*.ogg",
          "assets/*.wav",
          "assets/*.wasm"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "overrides": {
      "onnxruntime-web": "1.31.1"
    }
  }
}
